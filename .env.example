# Supabase: use the pooled connection string for your application.
# Append ?pgbouncer=true if the copied URL does not already include it.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20&sslmode=require"

# Supabase: use the direct connection string for schema changes and seeding.
# Session pooler supports IPv4, including local Windows and migration runners.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Generate a unique value of at least 32 characters outside development.
SESSION_SECRET="replace-with-a-long-random-secret-of-at-least-32-characters"

# Public origin used for metadata and catalog links.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Public business contact details, shown on the contact page when provided.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Optional exact HTTPS image hostname(s), separated by commas. Rebuild after edits.
PRODUCT_IMAGE_HOST=

# Product-photo uploads from /admin to Supabase Storage. Only the secret key is required:
# the project URL is derived from DATABASE_URL (set SUPABASE_URL only to override it).
# Key: Supabase → Project Settings → API Keys → secret key (sb_secret_…) or legacy service_role.
# Server-only — never prefix with NEXT_PUBLIC_. A public bucket is created on first upload if missing.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET="product-images"

# Optional Meta integration. Hora works normally when these are empty.
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_ACCESS_TOKEN=

# Optional shared token for /api/catalog/meta.csv. Empty disables token checking locally.
META_CATALOG_FEED_TOKEN=

# Development-only seeded credentials. Change immediately outside local development.
SEED_ADMIN_EMAIL="admin@hora.tn"
SEED_ADMIN_PASSWORD="HoraAdmin123!"
SEED_CUSTOMER_EMAIL="client@hora.tn"
SEED_CUSTOMER_PASSWORD="HoraClient123!"

# Server-only Sheets export. Share the spreadsheet with this account as Editor.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME="Orders"
# Tab read by Admin → Products → "Sync products now". Created with headers on the first sync.
GOOGLE_SHEETS_PRODUCTS_TAB_NAME="Products"
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste private_key from the downloaded JSON; literal \n escapes are supported.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
CRON_SECRET=

# Local production-admin setup only. Do not deploy these values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
