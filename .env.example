# PostgreSQL used by Prisma. The Docker Compose defaults match this value.
DATABASE_URL="postgresql://hora:hora_dev_password@localhost:5432/hora?schema=public"

# Generate a unique value of at least 32 characters outside development.
SESSION_SECRET="replace-with-a-long-random-secret-of-at-least-32-characters"

# Public origin used for metadata and catalog links.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Optional Meta integration. Hora works normally when these are empty.
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_ACCESS_TOKEN=

# Optional shared token for /api/catalog/meta.csv. Empty disables token checking locally.
META_CATALOG_FEED_TOKEN=

# Development-only seeded credentials. Change immediately outside local development.
SEED_ADMIN_EMAIL="admin@hora.tn"
SEED_ADMIN_PASSWORD="HoraAdmin123!"
SEED_CUSTOMER_EMAIL="client@hora.tn"
SEED_CUSTOMER_PASSWORD="HoraClient123!"
